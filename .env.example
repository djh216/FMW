# Google Maps — Distance Matrix API (drive times/ETAs) and Directions API (map route lines)
# Enable "Distance Matrix API" and "Directions API" in Google Cloud Console for this key.
GOOGLE_MAPS_API_KEY=

# Optional: API URL when hosting the dashboard on GitHub Pages (static frontend only).
# Example: https://your-api.example.com/api
# VITE_API_URL=
